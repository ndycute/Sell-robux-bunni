ecoration:none;font-weight:900;transition:transform .2s,box-shadow .2s}.button:hover{transform:translateY(-2px);box-shadow:0 12px 24px rgba(60,144,200,.2)}.button-blue{background:linear-gradient(135deg,#62b8ef,#82cdf7);color:white;box-shadow:0 10px 22px rgba(74,164,221,.22)}.button-white{background:white;color:#478cba;border:1px solid #d9efff}.trust-row{display:flex;gap:20px;flex-wrap:wrap;margin-top:29px;color:#6b91a9;font-size:.9rem;font-weight:800}.hero-art{position:relative;display:grid;place-items:center;min-height:430px}.halo{position:absolute;width:min(390px,85vw);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#fff 0 45%,#dff3ff 46% 67%,transparent 68%)}.bunny-card{position:relative;display:grid;place-items:center;width:min(370px,90%);height:380px;border:8px solid white;border-radius:48% 48% 40% 40%;background:linear-gradient(160deg,#fff,#e3f5ff);box-shadow:var(--shadow);overflow:hidden}.bunny-card img{position:absolute;width:100%;height:100%;object-fit:cover}.bunny-illustration{position:relative;width:230px;height:205px;transform:translateY(-15px)}.bunny-face{position:absolute;left:39px;top:35px;width:152px;height:132px;border-radius:50% 50% 46% 46%;background:#fff;box-shadow:0 8px 0 #d9f0ff;z-index:2}.bunny-ear{position:absolute;top:0;width:58px;height:113px;border-radius:55% 55% 45% 45%;background:#fff;border:2px solid #d8efff}.ear-left{left:36px;transform:rotate(-25deg)}.ear-right{right:34px;transform:rotate(25deg)}.eye{position:absolute;top:58px;width:10px;height:17px;border-radius:50%;background:#548caf}.eye-left{left:43px}.eye-right{right:43px}.cheek{position:absolute;top:82px;width:20px;height:11px;border-radius:50%;background:#ffc9dc}.cheek-left{left:21px}.cheek-right{right:21px}.mouth{position:absolute;left:68px;top:81px;width:17px;height:10px;border-bottom:3px solid #548caf;border-radius:50%}.flower{position:absolute;z-index:3;color:#b9a2ed;font-size:36px;text-shadow:0 2px #fff}.flower-left{left:22px;top:31px}.flower-right{right
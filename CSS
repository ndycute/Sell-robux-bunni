content:space-between;align-items:center;gap:15px;color:#7a99ad;font-size:.9rem}.footer-brand{font-size:.95rem}.modal-backdrop[hidden],.admin-panel[hidden]{display:none}.modal-backdrop{position:fixed;inset:0;z-index:80;display:grid;place-items:center;padding:18px;background:rgba(45,83,111,.42);backdrop-filter:blur(5px)}.zalo-modal{position:relative;width:min(460px,100%);overflow:hidden;padding:35px 25px 27px;border:5px solid white;border-radius:32px;background:linear-gradient(145deg,#8ecfff,#dff5ff 68%,#fff);box-shadow:0 24px 70px rgba(32,94,137,.28);text-align:center}.zalo-modal:before,.zalo-modal:after{content:'☁';position:absolute;color:rgba(255,255,255,.9);font-size:95px;line-height:1;pointer-events:none}.zalo-modal:before{top:-13px;left:-9px}.zalo-modal:after{right:-8px;bottom:-18px}.modal-close{position:absolute;top:10px;right:12px;z-index:2;width:37px;height:37px;border:0;border-radius:50%;background:#ffffffd9;color:#367da9;font-size:25px}.modal-cloud{position:relative;z-index:1;font-size:38px}.zalo-modal h2,.zalo-modal p,.zalo-modal .eyebrow,.zalo-modal small,.zalo-link{position:relative;z-index:1}.zalo-modal h2{margin:12px 0;color:#246a9b;font:800 2rem/1.12 'Baloo 2',sans-serif}.zalo-modal h2 strong{color:#1688d3}.zalo-modal p{color:#376983;font-size:1.05rem;font-weight:900}.zalo-link{margin:10px auto 16px}.zalo-modal small{display:block;color:#547a92;line-height:1.5}.admin-panel{position:fixed;right:16px;top:88px;z-index:70;width:min(390px,calc(100% - 32px));max-height:calc(100vh - 105px);overflow:auto;padding:20px;border:1px solid #d9edf9;border-radius:22px;background:white;box-shadow:0 18px 55px rgba(37,84,117,.22)}.admin-head{display:flex;justify-content:space-between;align-items:center;color:#347da9;font-size:1.1rem}.admin-head button{border:0;border-radius:50%;width:34px;height:34px;background:#edf8ff;color:#397ea8;font-size:23px}.admin-note{color:#7892a3;font-size:.85rem;line-height:1.5}.admin-panel label{display:grid;gap:6px;margin:13px 0;color:#456